{
    "name": "ai-desktop-agent",
    "version": "1.0.0",
    "description": "AI Desktop Agent - Ultimate automation assistant",
    "main": "src/main/index.js",
    "scripts": {
        "start": "electron .",
        "dev": "electron . --dev",
        "build": "webpack --mode production",
        "test": "jest",
        "test:watch": "jest --watch",
        "test:coverage": "jest --coverage",
        "test:e2e": "playwright test",
        "lint": "eslint src/**/*.js",
        "lint:fix": "eslint src/**/*.js --fix"
    },
    "keywords": [
        "ai",
        "automation",
        "desktop",
        "agent",
        "electron"
    ],
    "author": "AI Desktop Agent Team",
    "license": "MIT",
    "devDependencies": {
        "@babel/core": "^7.23.0",
        "@babel/preset-env": "^7.23.0",
        "@babel/preset-react": "^7.28.5",
        "@playwright/test": "^1.40.0",
        "autoprefixer": "^10.4.24",
        "babel-loader": "^10.0.0",
        "css-loader": "^7.1.3",
        "electron-builder": "^24.9.0",
        "eslint": "^8.55.0",
        "jest": "^29.7.0",
        "jest-environment-jsdom": "^29.7.0",
        "postcss": "^8.5.6",
        "postcss-loader": "^8.2.0",
        "style-loader": "^4.0.0",
        "tailwindcss": "^4.1.18",
        "webpack": "^5.89.0",
        "webpack-cli": "^5.1.4"
    },
    "dependencies": {
        "@anthropic-ai/sdk": "^0.24.0",
        "@tailwindcss/postcss": "^4.1.18",
        "axios": "^1.6.0",
        "chromadb": "^1.7.0",
        "clipboardy": "^5.2.1",
        "electron": "^27.0.0",
        "electron-store": "^8.1.0",
        "fluent-ffmpeg": "^2.1.2",
        "lucide-react": "^0.563.0",
        "mammoth": "^1.11.0",
        "openai": "^4.20.0",
        "pdf-parse": "^1.1.1",
        "puppeteer": "^21.7.0",
        "react": "^19.2.4",
        "react-dom": "^19.2.4",
        "tesseract.js": "^5.0.4",
        "xlsx": "^0.18.5"
    },
    "jest": {
        "testEnvironment": "node",
        "coverageDirectory": "coverage",
        "collectCoverageFrom": [
            "src/**/*.js",
            "!src/main/index.js",
            "!src/renderer/**"
        ],
        "testMatch": [
            "**/__tests__/**/*.test.js",
            "**/?(*.)+(spec|test).js"
        ],
        "setupFilesAfterEnv": [
            "<rootDir>/jest.setup.js"
        ],
        "moduleNameMapper": {
            "^@/(.*)$": "<rootDir>/src/$1"
        }
    }
}
